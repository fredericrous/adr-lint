# greenspotter: the exact code rules, checked as files are written
pre-commit  greenspotter-check  *.rs,*.ts,*.tsx,*.mts,*.cts,*.go,*.py,greenspotter.toml,tsconfig.json,tsconfig.base.json,tsconfig.app.json,tsconfig.node.json,pyproject.toml,go.mod+.adr.yaml  warn  files greenspotter check --
pre-push  greenspotter-candidates  *.rs,*.ts,*.tsx,*.go,*.py+.adr.yaml  warn  greenspotter candidates --base default
pre-push  greenspotter-cli-probe  +greenspotter.toml  warn  heavy greenspotter cli-probe
